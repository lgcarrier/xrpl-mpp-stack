# "single_token" or "redis_gateways"
GATEWAY_AUTH_MODE=single_token
# development template defaults to XRPL Testnet
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
# only permits http://localhost or a loopback IP when explicitly true
ALLOW_INSECURE_XRPL_RPC=false
# buyer signer ceiling for the final autofilled XRPL transaction Fee, in drops
XRPL_MPP_MAX_FEE_DROPS=1000
# optional bounded IOU pathfinding; source currency and absolute cap are paired
XRPL_MPP_IOU_SOURCE_CURRENCY=
XRPL_MPP_IOU_MAX_SOURCE_AMOUNT=
# 0-1000 basis points; used only when the paired IOU source policy is configured
XRPL_MPP_IOU_SLIPPAGE_BPS=50
MY_DESTINATION_ADDRESS=rYourXRPLReceivingAddressHere1234567890...
FACILITATOR_BEARER_TOKEN=replace-with-a-random-shared-secret
# use redis://redis:6379/0 in Docker Compose
REDIS_URL=redis://127.0.0.1:6379/0
# mainnet, testnet, or devnet
NETWORK_ID=testnet
# buyer-side network for examples
XRPL_NETWORK=testnet
# validated is the only supported settlement mode
SETTLEMENT_MODE=validated
VALIDATION_TIMEOUT=15
# 0.001 XRP minimum
MIN_XRP_DROPS=1000
# optional extra CODE:ISSUER pairs beyond built-in RLUSD/USDC
ALLOWED_ISSUED_ASSETS=
# optional comma-separated MPT issuance IDs
ALLOWED_MPT_ISSUANCE_IDS=
# set true only for local dev or trusted internal access
ENABLE_API_DOCS=false
# optional host port override for the facilitator Docker service
FACILITATOR_PORT=8000
# optional host port override for the merchant Docker service
MERCHANT_PORT=8010
# reject oversized payment requests before route handling
MAX_REQUEST_BODY_BYTES=32768
# 7 days of Redis replay markers
REPLAY_PROCESSED_TTL_SECONDS=604800
# maximum accepted transaction freshness window in ledgers
MAX_PAYMENT_LEDGER_WINDOW=20
# buyer wallet seed for examples and Docker Compose demos
XRPL_WALLET_SEED=
# user-asset-unit ceiling; optional for CLI/proxy and required for MCP auto-pay
XRPL_MPP_MAX_SPEND=
# required operator-approved recipient for xrpl-mpp automatic signing
XRPL_MPP_EXPECTED_RECIPIENT=
# optional local receipt store override for xrpl-mpp payer
XRPL_MPP_RECEIPTS_PATH=
# shared HMAC secret for binding MPP challenges
MPP_CHALLENGE_SECRET=
# comma-separated verification-only HMAC keys retained during rotation
MPP_CHALLENGE_PREVIOUS_SECRETS=
# optional override for the middleware challenge realm
MPP_DEFAULT_REALM=
# middleware/facilitator challenge TTL in seconds
MPP_CHALLENGE_TTL_SECONDS=300
# optional PayChannel allowlist and recipient-side redemption controls
PAYCHANNEL_PAYER_PUBLIC_KEY=
# recipient seed must derive MY_DESTINATION_ADDRESS; leave empty to retain final vouchers off-ledger
PAYCHANNEL_RECIPIENT_SEED=
PAYCHANNEL_MIN_SETTLE_DELAY=3600
PAYCHANNEL_SETTLEMENT_MARGIN_SECONDS=60
# reject unattended recipient claims above this XRPL Fee, in drops
PAYCHANNEL_MAX_REDEMPTION_FEE_DROPS=1000
# 0 disables background claims; enable to redeem unclaimed high-water vouchers
PAYCHANNEL_REDEEM_INTERVAL_SECONDS=0
# 0 disables idle session finalization; requires the background worker above
PAYCHANNEL_IDLE_CLOSE_SECONDS=0
PAYCHANNEL_REDEEM_BATCH_SIZE=100
# distributed claim lease; effective floor is VALIDATION_TIMEOUT + 60
PAYCHANNEL_REDEEM_LEASE_SECONDS=75
# seller-to-facilitator origin; production and the default client require HTTPS
FACILITATOR_URL=https://facilitator.example
FACILITATOR_TOKEN=replace-with-a-random-shared-secret
MERCHANT_XRPL_ADDRESS=rYourXRPLReceivingAddressHere1234567890...
# merchant example price in MPP base units and canonical currency form
PRICE_AMOUNT=1000
PRICE_CURRENCY=XRP
# buyer-side canonical currency, e.g. XRP or compact XRPL JSON
PAYMENT_CURRENCY=XRP
